# MiniSense Environment Configuration

# LLM Provider: 'gemini', 'openai', or 'mock'
LLM_PROVIDER=gemini

# API Keys (set according to selected provider)
GEMINI_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=

# Model Configuration
LLM_MODEL=gemini-1.5-flash
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Storage / Paths
DATA_DIR=data
SURVEYS_FILE=data/surveys.json
FAQ_FILE=data/faq.txt
FAISS_INDEX_DIR=data/faiss_index
